[flake8]
max-line-length = 100
per-file-ignores =
    # Ignore E501 (line too long), E402 (module level import not at top of file),
    # E231 (missing whitespace after ':'), and E225 (missing whitespace around operator)
    # for all files
    __init__.py: E501, E402, E231, E225
    *.py: E501, E402, E203, E231, E225

exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    .eggs,
    *.egg,
    .tox,
    .mypy_cache,
    .pytest_cache
