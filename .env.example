# Azure DevOps Configuration (optional - configure if you want to extract from Azure DevOps)
AZURE_DEVOPS_ORGANIZATION=your-organization-name
AZURE_DEVOPS_PAT=your-personal-access-token

# GitHub Configuration (optional - configure if you want to extract from GitHub)
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-organization-or-username
GITHUB_TYPE=org                    # 'org' for organization, 'user' for personal account

# Output Configuration
OUTPUT_FILENAME=pr_data.xlsx

# Performance Options
MAX_PARALLEL_WORKERS=16            # Number of parallel workers for API calls

# API Configuration
API_HOST=0.0.0.0                   # API server host (default: 0.0.0.0)
API_PORT=8000                      # API server port (default: 8000)
API_RELOAD=false                   # Auto-reload on code changes (dev only, default: false)
CACHE_TTL=300                      # Cache time-to-live in seconds (default: 300 = 5 minutes)

# Dashboard Configuration
DATA_MODE=api                      # Data source mode: 'api' (real-time) or 'excel' (static file)
API_URL=http://localhost:8000      # API endpoint URL for dashboard

# Note: You can configure both platforms to extract from both Azure DevOps and GitHub,
# or configure just one platform to extract from a single source.
