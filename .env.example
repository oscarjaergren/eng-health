# Configure one or both platforms. Both values of a pair are required.

# Azure DevOps: a PAT with Code (Read) scope.
AZURE_DEVOPS_ORGANIZATION=
AZURE_DEVOPS_PAT=
# AZURE_DEVOPS_URL=https://devops.example.com/tfs   # Azure DevOps Server only; ORGANIZATION is the collection

# GitHub: a token that can read the repositories and their pull requests.
GITHUB_OWNER=
GITHUB_TOKEN=
GITHUB_TYPE=org                # org or user
# GITHUB_API_URL=https://github.example.com/api/graphql   # GitHub Enterprise Server only

# Optional
# DATA_DIR=data                # where the SQLite database is kept
# MAX_PARALLEL_WORKERS=8       # concurrent API requests
# IDENTITY_ALIASES=jdoe=jane.doe@example.com   # merge one person's identities
# MOCK_MODE=true               # show generated sample data instead
# LOG_LEVEL=DEBUG              # dashboard log detail
# RUST_LOG=prsync=debug        # prsync: log every API request
