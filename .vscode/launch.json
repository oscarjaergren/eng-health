{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "dashboard_main.py"
            ],
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true,
            "console": "internalConsole",
            "serverReadyAction": {
                "pattern": "Local URL: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": "Dashboard (sample data)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "dashboard_main.py"
            ],
            "env": {
                "MOCK_MODE": "true"
            },
            "justMyCode": true,
            "console": "internalConsole",
            "serverReadyAction": {
                "pattern": "Local URL: (https?://\\S+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}
